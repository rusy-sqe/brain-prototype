      {
        "selector": "JSXOpeningElement[name.name='TreemapItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|color|key|ref|className|style|children)$/]",
        "message": "<TreemapItem> doesn't accept that prop. Declared props: name, value, color."
