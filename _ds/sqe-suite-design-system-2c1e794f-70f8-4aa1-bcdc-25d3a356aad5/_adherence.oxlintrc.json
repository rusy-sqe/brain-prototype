        "selector": "JSXOpeningElement[name.name='WaterfallItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|type|color|key|ref|className|style|children)$/]",
        "message": "<WaterfallItem> doesn't accept that prop. Declared props: name, value, type, color."
