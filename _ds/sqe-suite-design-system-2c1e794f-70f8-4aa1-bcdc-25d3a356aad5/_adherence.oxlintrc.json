      {
        "selector": "JSXOpeningElement[name.name='TrackerBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|tooltip|key|ref|className|style|children)$/]",
        "message": "<TrackerBlock> doesn't accept that prop. Declared props: color, tooltip."
