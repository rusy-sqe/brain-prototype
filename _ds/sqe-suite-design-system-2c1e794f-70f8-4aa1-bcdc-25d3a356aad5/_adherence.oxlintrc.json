{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Icon/**",
              "components/Map/**",
              "components/charts/AreaChart/**",
              "components/charts/BarChart/**",
              "components/charts/ComboChart/**",
              "components/charts/DonutChart/**",
              "components/charts/FunnelChart/**",
              "components/charts/GaugeChart/**",
              "components/charts/Heatmap/**",
              "components/charts/LineChart/**",
              "components/charts/MicroCharts/**",
              "components/charts/RadarChart/**",
              "components/charts/RangeBarChart/**",
              "components/charts/SankeyChart/**",
              "components/charts/ScatterChart/**",
              "components/charts/TreemapChart/**",
              "components/charts/WaterfallChart/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Font Awesome 5 Brands|Font Awesome 5 Duotone|Font Awesome 5 Pro|Inter|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: Font Awesome 5 Brands, Font Awesome 5 Duotone, Font Awesome 5 Pro, Inter, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|index|categories|colors|valueFormatter|height|stack|curve|fill|showLegend|showGridLines|showXAxis|showYAxis|yAxisWidth|minValue|maxValue|startEndOnly|className|style|key|ref|className|style|children)$/]",
        "message": "<AreaChart> doesn't accept that prop. Declared props: data, index, categories, colors, valueFormatter, height, stack, curve, fill, showLegend, showGridLines, showXAxis, showYAxis, yAxisWidth, minValue, maxValue, startEndOnly, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaChart'] > JSXAttribute[name.name='curve'] > Literal[value!=/^(?:smooth|linear)$/]",
        "message": "<AreaChart> curve must be one of 'smooth' | 'linear'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaChart'] > JSXAttribute[name.name='fill'] > Literal[value!=/^(?:gradient|solid|none)$/]",
        "message": "<AreaChart> fill must be one of 'gradient' | 'solid' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|index|categories|colors|valueFormatter|height|type|layout|barRadius|barGap|showLegend|showGridLines|showXAxis|showYAxis|yAxisWidth|maxValue|className|style|key|ref|className|style|children)$/]",
        "message": "<BarChart> doesn't accept that prop. Declared props: data, index, categories, colors, valueFormatter, height, type, layout, barRadius, barGap, showLegend, showGridLines, showXAxis, showYAxis, yAxisWidth, maxValue, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:grouped|stacked|percent)$/]",
        "message": "<BarChart> type must be one of 'grouped' | 'stacked' | 'percent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<BarChart> layout must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|color|href|key|ref|className|style|children)$/]",
        "message": "<BarListItem> doesn't accept that prop. Declared props: name, value, color, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:values|colors|labels|marker|markerLabel|valueFormatter|barHeight|showLabels|className|style|key|ref|className|style|children)$/]",
        "message": "<CategoryBar> doesn't accept that prop. Declared props: values, colors, labels, marker, markerLabel, valueFormatter, barHeight, showLabels, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComboChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|index|barCategories|lineCategories|barColors|lineColors|valueFormatter|lineValueFormatter|height|stackBars|curve|barRadius|showLegend|showGridLines|yAxisWidth|rightAxisWidth|className|style|key|ref|className|style|children)$/]",
        "message": "<ComboChart> doesn't accept that prop. Declared props: data, index, barCategories, lineCategories, barColors, lineColors, valueFormatter, lineValueFormatter, height, stackBars, curve, barRadius, showLegend, showGridLines, yAxisWidth, rightAxisWidth, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComboChart'] > JSXAttribute[name.name='curve'] > Literal[value!=/^(?:smooth|linear)$/]",
        "message": "<ComboChart> curve must be one of 'smooth' | 'linear'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|index|category|colors|valueFormatter|variant|size|thickness|gap|label|showLabel|showLegend|legendPosition|className|style|key|ref|className|style|children)$/]",
        "message": "<DonutChart> doesn't accept that prop. Declared props: data, index, category, colors, valueFormatter, variant, size, thickness, gap, label, showLabel, showLegend, legendPosition, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutChart'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:donut|pie)$/]",
        "message": "<DonutChart> variant must be one of 'donut' | 'pie'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutChart'] > JSXAttribute[name.name='legendPosition'] > Literal[value!=/^(?:right|bottom)$/]",
        "message": "<DonutChart> legendPosition must be one of 'right' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FunnelChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|index|category|colors|color|valueFormatter|variant|height|gap|showValues|showConversion|conversionMode|className|style|key|ref|className|style|children)$/]",
        "message": "<FunnelChart> doesn't accept that prop. Declared props: data, index, category, colors, color, valueFormatter, variant, height, gap, showValues, showConversion, conversionMode, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FunnelChart'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:trapezoid|bars)$/]",
        "message": "<FunnelChart> variant must be one of 'trapezoid' | 'bars'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FunnelChart'] > JSXAttribute[name.name='conversionMode'] > Literal[value!=/^(?:previous|first)$/]",
        "message": "<FunnelChart> conversionMode must be one of 'previous' | 'first'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GaugeThreshold'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|to|color|key|ref|className|style|children)$/]",
        "message": "<GaugeThreshold> doesn't accept that prop. Declared props: from, to, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeatmapCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:x|y|value|key|ref|className|style|children)$/]",
        "message": "<HeatmapCell> doesn't accept that prop. Declared props: x, y, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|variant|size|fw|spin|pulse|color|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, variant, size, fw, spin, pulse, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|regular|light|brands|duotone)$/]",
        "message": "<Icon> variant must be one of 'solid' | 'regular' | 'light' | 'brands' | 'duotone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|lg|2x|3x|4x|5x|6x|7x|8x|9x|10x)$/]",
        "message": "<Icon> size must be one of 'xs' | 'sm' | 'lg' | '2x' | '3x' | '4x' | '5x' | '6x' | '7x' | '8x' | '9x' | '10x'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|index|categories|colors|valueFormatter|height|curve|strokeWidth|showDots|dashed|showLegend|showGridLines|showXAxis|showYAxis|yAxisWidth|minValue|maxValue|startEndOnly|connectNulls|className|style|key|ref|className|style|children)$/]",
        "message": "<LineChart> doesn't accept that prop. Declared props: data, index, categories, colors, valueFormatter, height, curve, strokeWidth, showDots, dashed, showLegend, showGridLines, showXAxis, showYAxis, yAxisWidth, minValue, maxValue, startEndOnly, connectNulls, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineChart'] > JSXAttribute[name.name='curve'] > Literal[value!=/^(?:smooth|linear)$/]",
        "message": "<LineChart> curve must be one of 'smooth' | 'linear'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MineMapBoundary'] > JSXAttribute > JSXIdentifier[name!=/^(?:positions|color|label|key|ref|className|style|children)$/]",
        "message": "<MineMapBoundary> doesn't accept that prop. Declared props: positions, color, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|index|categories|colors|valueFormatter|height|maxValue|rings|shape|fillOpacity|showLegend|showDots|labelOffset|className|style|key|ref|className|style|children)$/]",
        "message": "<RadarChart> doesn't accept that prop. Declared props: data, index, categories, colors, valueFormatter, height, maxValue, rings, shape, fillOpacity, showLegend, showDots, labelOffset, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadarChart'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:polygon|circle)$/]",
        "message": "<RadarChart> shape must be one of 'polygon' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeSeries'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|low|high|color|key|ref|className|style|children)$/]",
        "message": "<RangeSeries> doesn't accept that prop. Declared props: name, low, high, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SankeyLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|target|value|key|ref|className|style|children)$/]",
        "message": "<SankeyLink> doesn't accept that prop. Declared props: source, target, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScatterChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|x|y|size|category|label|colors|valueFormatter|height|dotSize|sizeRange|xAxisLabel|yAxisLabel|showLegend|showGridLines|yAxisWidth|className|style|key|ref|className|style|children)$/]",
        "message": "<ScatterChart> doesn't accept that prop. Declared props: data, x, y, size, category, label, colors, valueFormatter, height, dotSize, sizeRange, xAxisLabel, yAxisLabel, showLegend, showGridLines, yAxisWidth, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SparkChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|index|categories|colors|type|height|curve|strokeWidth|showLastDot|fill|className|style|key|ref|className|style|children)$/]",
        "message": "<SparkChart> doesn't accept that prop. Declared props: data, index, categories, colors, type, height, curve, strokeWidth, showLastDot, fill, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SparkChart'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:area|line|bar)$/]",
        "message": "<SparkChart> type must be one of 'area' | 'line' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SparkChart'] > JSXAttribute[name.name='curve'] > Literal[value!=/^(?:smooth|linear)$/]",
        "message": "<SparkChart> curve must be one of 'smooth' | 'linear'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SparkChart'] > JSXAttribute[name.name='fill'] > Literal[value!=/^(?:gradient|solid|none)$/]",
        "message": "<SparkChart> fill must be one of 'gradient' | 'solid' | 'none'."
